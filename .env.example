# ============================================================
# Nexus-Agent Configuration Environment Variables
# ============================================================

# LLM Provider: 'mock', 'openai', 'anthropic', 'gemini', 'ollama', 'deepseek'
# Default: 'mock' allows full testing and dry-run without any API keys!
NEXUS_LLM_PROVIDER=mock

# Model Name
NEXUS_MODEL=mock-model

# API Keys (set according to your provider)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Local Ollama URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Execution Parameters
NEXUS_MAX_ITERATIONS=25
NEXUS_TEMPERATURE=0.2
NEXUS_ENABLE_AST_VALIDATION=true
NEXUS_MEMORY_DB_PATH=nexus_memory.db

# Web Dashboard Settings
NEXUS_WEB_HOST=127.0.0.1
NEXUS_WEB_PORT=8000
